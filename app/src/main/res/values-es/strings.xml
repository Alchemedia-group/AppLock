    <string name="guide_title">Activar la protección</string>
    <string name="guide_intro">Android oculta este interruptor a propósito, así que hacen falta unos toques. Sigue los pasos en orden. Esta página marca el paso 2 sola cuando funciona.</string>
    <string name="guide_step1_title">Permitir ajustes restringidos</string>
    <string name="guide_step1_body">Android bloquea las apps instaladas desde un archivo hasta que las permites.</string>
    <string name="guide_step1_a">Toca el botón de abajo para abrir la información de la app de AppLock.</string>
    <string name="guide_step1_b">Toca el menú ⋮ de arriba a la derecha.</string>
    <string name="guide_step1_c">Toca «Permitir ajustes restringidos» y confirma con tu PIN o huella.</string>
    <string name="guide_step1_missing">¿No ves «Permitir ajustes restringidos»? Haz primero el paso 2 e intenta activar AppLock. Android muestra un aviso de bloqueo y la opción aparece después en el menú ⋮.</string>
    <string name="guide_step1_action">Abrir la información de la app de AppLock</string>
    <string name="guide_mock_title">Información de la app</string>
    <string name="guide_mock_item">Permitir ajustes restringidos</string>
    <string name="guide_step2_title">Activa el servicio de AppLock</string>
    <string name="guide_step2_a">Toca el botón de abajo para abrir los ajustes de Accesibilidad.</string>
    <string name="guide_step2_b">Abre: %1$s.</string>
    <string name="guide_step2_c">Activa el interruptor y toca Permitir.</string>
    <string name="guide_path_samsung">Apps instaladas y luego AppLock</string>
    <string name="guide_path_other">Apps instaladas o Apps descargadas y luego AppLock</string>
    <string name="guide_step2_action">Abrir ajustes de Accesibilidad</string>
    <string name="guide_step3_title">Comprueba que funciona</string>
    <string name="guide_step3_wait">Se marca solo cuando el servicio está activo. Vuelve aquí después de activarlo.</string>
    <string name="guide_step3_done">El servicio está funcionando. Las apps bloqueadas pedirán ahora tu PIN o patrón.</string>
    <string name="guide_trouble_title">¿Sigues atascado?</string>
    <string name="guide_trouble_grey">El interruptor está en gris: repite el paso 1 y vuelve a intentar el paso 2.</string>
    <string name="guide_trouble_missing">AppLock no aparece en la lista: reinstala la app y empieza de nuevo desde el paso 1.</string>
    <string name="guide_trouble_off">Se desactiva solo: abre la información de la app, toca Batería y elige Sin restricciones.</string>
    <string name="guide_trouble_brand">Xiaomi, Oppo, Vivo, OnePlus y otros: permite también el inicio automático o la actividad en segundo plano de AppLock en los ajustes de seguridad o batería del teléfono.</string>
