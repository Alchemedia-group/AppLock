    <string name="help_how_to_enable">Come lo attivo?</string>
    <string name="guide_title">Attiva la protezione</string>
    <string name="guide_intro">Android nasconde di proposito questo interruttore, quindi servono alcuni tocchi. Segui i passaggi in ordine. Questa pagina spunta da sola il passaggio 2 quando funziona.</string>
    <string name="guide_step1_title">Consenti impostazioni con restrizioni</string>
    <string name="guide_step1_body">Android blocca le app installate da un file finché non le consenti.</string>
    <string name="guide_step1_a">Tocca il pulsante qui sotto per aprire la pagina Informazioni app di AppLock.</string>
    <string name="guide_step1_b">Tocca il menu ⋮ in alto a destra.</string>
    <string name="guide_step1_c">Tocca «Consenti impostazioni con restrizioni», poi conferma con PIN o impronta.</string>
    <string name="guide_step1_missing">Non vedi «Consenti impostazioni con restrizioni»? Esegui prima il passaggio 2 e prova ad attivare AppLock. Android mostra un avviso di blocco e poi l’opzione compare nel menu ⋮.</string>
    <string name="guide_step1_action">Apri Informazioni app di AppLock</string>
    <string name="guide_mock_title">Informazioni app</string>
    <string name="guide_mock_item">Consenti impostazioni con restrizioni</string>
    <string name="guide_step2_title">Attiva il servizio AppLock</string>
    <string name="guide_step2_a">Tocca il pulsante qui sotto per aprire le impostazioni di Accessibilità.</string>
    <string name="guide_step2_b">Apri: %1$s.</string>
    <string name="guide_step2_c">Attiva l’interruttore, poi tocca Consenti.</string>
    <string name="guide_path_samsung">App installate, poi AppLock</string>
    <string name="guide_path_other">App installate o App scaricate, poi AppLock</string>
    <string name="guide_step2_action">Apri le impostazioni di Accessibilità</string>
    <string name="guide_step3_title">Controlla che funzioni</string>
    <string name="guide_step3_wait">Si spunta da solo quando il servizio è attivo. Torna qui dopo averlo attivato.</string>
    <string name="guide_step3_done">Il servizio è in esecuzione. Le app bloccate ora chiederanno il PIN o la sequenza.</string>
    <string name="guide_trouble_title">Sei ancora bloccato?</string>
    <string name="guide_trouble_grey">L’interruttore è disattivato: ripeti il passaggio 1, poi riprova il passaggio 2.</string>
    <string name="guide_trouble_missing">AppLock non è nell’elenco: reinstalla l’app e ricomincia dal passaggio 1.</string>
    <string name="guide_trouble_off">Si disattiva da solo: apri Informazioni app, tocca Batteria e scegli Senza limitazioni.</string>
    <string name="guide_trouble_brand">Xiaomi, Oppo, Vivo, OnePlus e altri: consenti anche l’avvio automatico o l’attività in background per AppLock nelle impostazioni di sicurezza o batteria del telefono.</string>
    <string name="guide_done">Fatto</string>
    <string name="guide_close">Chiudi</string>
